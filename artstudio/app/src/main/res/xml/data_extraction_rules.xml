<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Retain user preferences and saved projects metadata/files -->
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
        <include domain="file" path="projects" />

        <!-- Exclude temporary caches, exports, and scratch files -->
        <exclude domain="file" path="exports" />
        <exclude domain="file" path="temp" />
        <exclude domain="file" path="cache" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
        <include domain="file" path="projects" />
        <exclude domain="file" path="exports" />
        <exclude domain="file" path="temp" />
        <exclude domain="file" path="cache" />
    </device-transfer>
</data-extraction-rules>
